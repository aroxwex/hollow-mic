#include <windows.h>

1 ICON "app.ico"
1 24 "app.manifest"

// Mute / unmute sounds, embedded as raw WAV data (RCDATA)
101 RCDATA "../assets/sounds/hollow_on.wav"
102 RCDATA "../assets/sounds/hollow_off.wav"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Hollow Mic Project"
            VALUE "FileDescription", "Hollow Mic - microphone mute toggle"
            VALUE "LegalCopyright", "Copyright (C) 2026 Hollow Mic Project"
            VALUE "Comments", "System-wide microphone mute toggle. Offline, no registry access."
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "HollowMic"
            VALUE "OriginalFilename", "HollowMic.exe"
            VALUE "ProductName", "Hollow Mic"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
